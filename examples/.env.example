# Copy to .env and fill in. See examples/README.md for what each one is for.

DESCOPE_PROJECT_ID=P2xxxxxxxxxxxxxxxxxxxxxxxxxxx
# DESCOPE_BASE_URL=https://api.descope.com

# --- user_connection.py / userConnection.ts (acting for a user) ---
DESCOPE_USER_JWT=
DESCOPE_USER_IDENTIFIER=user@example.com
CONNECTION_NAME=github

# --- autonomous_agent.py / autonomousAgent.ts (client credentials, no user) ---
DESCOPE_CLIENT_ID=
DESCOPE_CLIENT_SECRET=
RESOURCE=urn:my-api
TENANT_ID=
