{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationDir": "dts",
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types"],
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"]
}
