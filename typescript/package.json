{
  "name": "@descope/agent-auth",
  "version": "0.2.0",
  "description": "Client-side SDK for wiring a custom agent to Descope: acquire a credential and exchange it for Connection/Resource tokens from the vault.",
  "typings": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descope/descope-agent-auth.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome ci",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint:fix": "biome check --write"
  },
  "author": "Descope",
  "bugs": {
    "url": "https://github.com/descope/descope-agent-auth/issues"
  },
  "license": "MIT",
  "keywords": [
    "descope",
    "agent",
    "auth",
    "oauth",
    "ciba",
    "outbound-apps"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "nock": "^14.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.0",
    "vitest": "^5.1.2"
  }
}
